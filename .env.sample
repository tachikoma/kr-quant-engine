# KRX(한국거래소) API 인증 정보
# pykrx 라이브러리를 통해 주식 데이터를 조회할 때 필요합니다.
# 실제 환경에서 사용할 때는 .env 파일을 생성하고 다음 값들을 설정하세요.
KRX_ID=your_krx_id
KRX_PW=your_krx_password

# 종목명 조회 활성화 여부
# KRX 인증 정보가 있을 때만 의미가 있습니다.
# 0: 비활성화 (기본값, 종목 티커만 사용)
# 1: 활성화 (실제 종목명을 조회하여 저장)
ENABLE_TICKER_NAME_LOOKUP=0

# 키움증권 API 인증 정보
KIWOOM_BASE_URL=https://api.kiwoom.com
KIWOOM_APPKEY=your_kiwoom_appkey
KIWOOM_SECRETKEY=your_kiwoom_secretkey

# Cash / deposit (kt00001 예수금상세현황요청)
# qry_tp: 2=일반조회, 3=추정조회
KIWOOM_CASH_QRY_TP=2

# Holdings / balance (kt00018 계좌평가잔고내역요청)
# qry_tp: 1=합산, 2=개별 / dmst_stex_tp: KRX=한국거래소, NXT=넥스트트레이드
KIWOOM_HOLDINGS_DMST_STEX_TP=KRX

# Price / quote (ka10004 주식호가요청)
# 기본값: 매수는 buy_fpr_bid, 매도는 sel_fpr_bid
# 계좌/환경 응답 차이가 있으면 output.xxx 또는 data.xxx 형태로 지정
KIWOOM_PRICE_PATH_BUY=buy_fpr_bid
KIWOOM_PRICE_PATH_SELL=sel_fpr_bid

# 가격/HTTP 디버그 옵션 (테스트 시에만 사용 권장)
KIWOOM_HTTP_DEBUG_RESPONSE=0
KIWOOM_HTTP_DEBUG_BODY=0
KIWOOM_HTTP_DEBUG_BODY_LIMIT=800
# HTTP 200 + return_code(예: 5) 제한 응답 시 고정 대기(초) 후 재시도
KIWOOM_HTTP_RETRY_DELAY=0.2
KIWOOM_HTTP_MIN_INTERVAL=0.2

# 라이브 러너 안전장치
# 1: 전략 유니버스(etf_list) 외 보유종목은 매도 대상에서 제외
PROTECT_EXTERNAL_HOLDINGS=1
# 1: 매도/매수 컷오프 중 더 이른 시각 이후에는 LIVE_ORDER_ENABLED=1 실행 차단
BLOCK_LIVE_AFTER_CUTOFF=1
