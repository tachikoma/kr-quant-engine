# KRX(한국거래소) API 인증 정보
# pykrx 라이브러리를 통해 주식 데이터를 조회할 때 필요합니다.
# 실제 환경에서 사용할 때는 .env 파일을 생성하고 다음 값들을 설정하세요.
KRX_ID=your_krx_id
KRX_PW=your_krx_password

# 종목명 조회 활성화 여부
# KRX 인증 정보가 있을 때만 의미가 있습니다.
# 0: 비활성화 (기본값, 종목 티커만 사용)
# 1: 활성화 (실제 종목명을 조회하여 저장)
ENABLE_TICKER_NAME_LOOKUP=0

# 공통 설정
ENV_MODE=real  # real(실전) / demo(모의)
BROKER_TYPE=KIWOOM  # KIWOOM 또는 KIS

# ETF_LIST=069500,091160,133690  # (선택) 쉼표 목록으로 ETF 후보풀 오버라이드

# ETF_USE_CACHE=1  # parquet 데이터 캐시 사용 (기본 1)
# ETF_REFRESH_CACHE=0  # 캐시 무시하고 pykrx 재조회 (기본 0)

# 키움증권 API 인증 정보 (BROKER_TYPE=KIWOOM 일 때)
KIWOOM_APPKEY=your_kiwoom_appkey
KIWOOM_SECRETKEY=your_kiwoom_secretkey

# Cash / deposit (kt00001 예수금상세현황요청)
# qry_tp: 2=일반조회, 3=추정조회
KIWOOM_CASH_QRY_TP=2

# Holdings / balance (kt00018 계좌평가잔고내역요청)
# qry_tp: 1=합산, 2=개별 / dmst_stex_tp: KRX=한국거래소, NXT=넥스트트레이드
KIWOOM_HOLDINGS_DMST_STEX_TP=KRX


# 가격/HTTP 디버그 옵션 (테스트 시에만 사용 권장)
KIWOOM_HTTP_DEBUG_RESPONSE=0
KIWOOM_HTTP_DEBUG_BODY=0
KIWOOM_HTTP_DEBUG_BODY_LIMIT=800
# HTTP 200 + return_code(예: 5) 제한 응답 시 고정 대기(초) 후 재시도
KIWOOM_HTTP_RETRY_DELAY=0.2
KIWOOM_HTTP_MIN_INTERVAL=0.2

# 라이브 러너 안전장치
# 1: 전략 유니버스(etf_list) 외 보유종목은 매도 대상에서 제외
PROTECT_EXTERNAL_HOLDINGS=1
# 1: 매도/매수 컷오프 중 더 이른 시각 이후에는 LIVE_ORDER_ENABLED=1 실행 차단
BLOCK_LIVE_AFTER_CUTOFF=1
# 1: 리밸런싱 강제 실행 (리밸런스 주기와 관계없이 당일 실행)
# FORCE_REBALANCE=0
# --force-live 시 컷오프를 연장할 분 (기본 15)
# FORCE_LIVE_CUTOFF_EXTEND_MIN=15

# 리밸런스 주기 (거래일 기준, 기본 10)
# REBALANCE_STEP_DAYS=10

# ---------------------------------------------------------------------------
# 슬리피지(Slippage) / 스프레드(Spread) 설정 예시
# 값 단위로 다양한 형식 허용: 예) 5bp, 0.5%, 0.0005
# - 백테스트에서는 스프레드(호가) + 슬리피지(체결영향)를 모델링합니다.
# - 실전에서는 기본적으로 API의 bid/ask 및 체결결과를 우선 신뢰합니다.
#   인위적 슬리피지를 실전에도 적용하려면 APPLY_SLIPPAGE_IN_LIVE=1 로 설정하세요.
# ---------------------------------------------------------------------------
# 백테스트 기본값 (단위: 소수, 예: 0.0005 == 5bp)
ETF_BASE_SLIPPAGE=0.0005
ETF_SPREAD_PCT=0.0005

# 실전 관련 설정
# 0: 실전에서는 인위적 슬리피지 미적용(권장 기본) / 1: 실전에서도 지정 슬리피지 적용
APPLY_SLIPPAGE_IN_LIVE=0
# 실전에서 인위적 슬리피지를 적용하려면 지정 (예: 5bp -> 0.0005)
LIVE_SLIPPAGE_PCT=0.0005
# 실전에서 API로 bid/ask를 얻지 못할 때의 fallback 스프레드
LIVE_SPREAD_PCT=0.0005

# KIS API 인증 정보 (BROKER_TYPE=KIS 일 때)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_ACCOUNT_PROD_CD=01
# KIS_CONFIG_PATH=  # 토큰 캐시 경로 (기본: .kis_token_cache/)

TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here