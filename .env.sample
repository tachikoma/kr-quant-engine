# KRX(한국거래소) API 인증 정보
# pykrx 라이브러리를 통해 주식 데이터를 조회할 때 필요합니다.
# 실제 환경에서 사용할 때는 .env 파일을 생성하고 다음 값들을 설정하세요.
KRX_ID=your_krx_id
KRX_PW=your_krx_password

# 종목명 조회 활성화 여부
# KRX 인증 정보가 있을 때만 의미가 있습니다.
# 0: 비활성화 (기본값, 종목 티커만 사용)
# 1: 활성화 (실제 종목명을 조회하여 저장)
ENABLE_TICKER_NAME_LOOKUP=0

# 공통 설정
ENV_MODE=real  # real(실전) / demo(모의)
BROKER_TYPE=KIWOOM  # KIWOOM 또는 KIS

# ETF_LIST=069500,091160,133690  # (선택) 쉼표 목록으로 ETF 후보풀 오버라이드

# ── 유니버스 자동 구축 (Phase 2) ───────────────────────────────
# ETF_UNIVERSE_MODE=static  # static(기본): 하드코딩 ETF_LIST 사용
# ETF_UNIVERSE_MODE=auto    # KRX 분류 기반 자동 구축 (실물 패시브 주식형 ETF)
#   필터: 실물(패시브) + 주식 + 일반(1x), 커버드콜 키워드 제외
#   그룹 자동 분류: 국내→domestic_equity, 해외→foreign_investment
#   참고: ETF_LIST env var가 설정되면 auto보다 우선 (명시적 override)
#   ⚠ 검증 결과: auto 유니버스는 static 대비 열등 (CAGR 12.2% vs 25.7%)
#     상세: DOCS/UNIVERSE_AUTO_ANALYSIS.md
# ETF_UNIVERSE_EXCLUDE_KEYWORDS=커버드콜  # 제외할 이름 키워드 (쉼표 구분, 기본: 커버드콜)
# ETF_UNIVERSE_INCLUDE_COMMODITY=0  # 1이면 원자재 ETF 포함 (기본 0: 주식형만)

# ETF_USE_CACHE=1  # parquet 데이터 캐시 사용 (기본 1)
# ETF_REFRESH_CACHE=0  # 캐시 무시하고 pykrx 재조회 (기본 0)

# 유동성 플래그: trailing 60거래일 평균(최소 20일) 거래대금이 이 값(원) 이상이면 liquidity_ok
# 각 리밸런싱 시점의 snapshot에서 as-of로 판단하여 후보에서 제외 (기본 10억)
# MIN_AVG_TRADING_VALUE=1000000000
# 랭킹 수익률 기준: price=가격, nav=NAV 근사, total_return=현금분배금 재투자
# ETF_RETURN_BASIS=price
# total_return 모드의 정규화 분배금 파일과 세율(기본 0: gross total return)
# ETF_DISTRIBUTIONS_FILE=data/etf_distributions.csv
# ETF_DISTRIBUTION_TAX_PCT=0
# 최소 상장 거래일 및 NAV 괴리율 필터
# MIN_LISTING_DAYS=60
# MAX_PREMIUM_DISCOUNT=0.02

# 그룹별 NAV 괴리율 임계값 (기본값은 MAX_PREMIUM_DISCOUNT와 동일한 2%)
# 해외 ETF/커버드콜의 구조적 괴리를 반영하려면 아래 예시처럼 완화 가능
# ETF_DEVIATION_THRESHOLD_BY_GROUP=domestic_equity=0.02,foreign_investment=0.05,commodity=0.05

# 티커별 NAV 괴리율 override (커버드콜 등 특수 ETF)
# ETF_DEVIATION_THRESHOLD_BY_TICKER=472150=0.04,486290=0.04,498400=0.04

# 키움증권 API 인증 정보 (BROKER_TYPE=KIWOOM 일 때)
KIWOOM_APPKEY=your_kiwoom_appkey
KIWOOM_SECRETKEY=your_kiwoom_secretkey

# Cash / deposit (kt00001 예수금상세현황요청)
# live runner는 실제 주문 가능 추정예수금 기준(qry_tp=3)을 사용합니다.

# Holdings / balance (kt00018 계좌평가잔고내역요청)
# qry_tp: 1=합산, 2=개별 / dmst_stex_tp: KRX=한국거래소, NXT=넥스트트레이드
KIWOOM_HOLDINGS_DMST_STEX_TP=KRX


# 가격/HTTP 디버그 옵션 (테스트 시에만 사용 권장)
KIWOOM_HTTP_DEBUG_RESPONSE=0
KIWOOM_HTTP_DEBUG_BODY=0
KIWOOM_HTTP_DEBUG_BODY_LIMIT=800
# HTTP 200 + return_code(예: 5) 제한 응답 시 고정 대기(초) 후 재시도
# (이제 ENV_MODE 기반 자동 설정: 실전 0.1s / 모의 1.0s)
# 필요시 아래 주석 해제하여 개별 오버라이드
# KIWOOM_HTTP_RETRY_DELAY=0.1
# KIWOOM_HTTP_MIN_INTERVAL=0.1

# 키움 토큰 캐시 디렉토리 (기본: .kiwoom_token_cache/)
# KIWOOM_TOKEN_CACHE_DIR=

# 라이브 러너 안전장치
# 1: 전략 유니버스(etf_list) 외 보유종목은 매도 대상에서 제외
PROTECT_EXTERNAL_HOLDINGS=1
# 1: 매도/매수 컷오프 중 더 이른 시각 이후에는 LIVE_ORDER_ENABLED=1 실행 차단
BLOCK_LIVE_AFTER_CUTOFF=1

# 로그 설정 (선택)
# LOG_LEVEL=INFO          # DEBUG: 필터별 탈락 티커 목록 포함 상세 로그, INFO: 요약만
# LOG_FILE=etf-daily-runner.log  # 파일 로깅 경로 (설정 시 일별 로테이션, 30일 보존)

# 1: 리밸런싱 강제 실행 (리밸런스 주기와 관계없이 당일 실행)
# FORCE_REBALANCE=0
# --force-live 시 컷오프를 연장할 분 (기본 15)
# FORCE_LIVE_CUTOFF_EXTEND_MIN=15

# 리밸런스 주기 (거래일 기준, 기본 20)
# REBALANCE_STEP_DAYS=20

# 시장가(MARKET) 주문 시 증권사가 추가로 확보하는 증거금 할증률
# Kiwoom은 시장가 주문에 대해 예수금의 ~20%를 추가 증거금으로 확보합니다.
# LIMIT 주문이나 KIS는 필요 없음 (기본 0.20 for Kiwoom, 0.0 for KIS)
# MARKET_ORDER_MARGIN_RATE=0.20

# Risk-off 시 행동 (기본 1: 전량 매도)
# 0: 보유 유지 / 1: 전량 매도 (실전 기본값)
# LIQUIDATE_ON_RISK_OFF=1

# 멀티 인덱스 리스크 시그널 (Phase 1)
# 0: 기존 KOSPI 단일 시그널 유지 / 1: KOSPI + 미국지수 게이팅
ENABLE_MULTI_INDEX_RISK=1
# 멀티 인덱스 게이팅 모드
# hybrid: KOSPI risk_on이면 전체 허용, KOSPI off + US on이면 미국군만 허용
# split: 국내군은 KOSPI, 미국군은 US 지수로 각각 독립 게이팅 (commodity는 항상 허용)
MULTI_INDEX_GATING_MODE=split
# 미국 리스크 프록시 심볼 (yfinance): SPY 또는 QQQ
US_RISK_PROXY=QQQ
# 미국 지수 리스크 판정 이동평균/기울기 윈도우
US_MARKET_MA_DAYS=120
US_MARKET_SLOPE_DAYS=20

# 종목당 포트폴리오 비중 상한 (기본 0.50)
# 0: 제한 없음 / 0.5: 50% 상한 / 그 외 0~1 사이 값
# MAX_ASSET_PCT=0.50

# 전체 포트폴리오 평가액 기준 목표비중 리밸런싱
# 0: 기존 현금만 균등 배분 / 1: 목표비중 벗어난 보유분도 부분 매수·매도
TARGET_WEIGHT_REBALANCE=0
# 목표비중 대비 허용할 절대 포트폴리오 비중 차이 (0.05 = 5%p)
REBALANCE_BAND_PCT=0.05

# 기존 승자 보유/현금 배분은 유지하고 MAX_ASSET_PCT 초과분만 부분매도
# TARGET_WEIGHT_REBALANCE=0인 기존 주문 방식에서 사용합니다.
TRIM_OVERWEIGHT_POSITIONS=0

# 백테스트 실험용 exit-only trailing overlay (0이면 비활성)
ETF_EXIT_CHECK_DAYS=0
ETF_TRAILING_STOP_PCT=0
ETF_PORTFOLIO_TRAILING_STOP_PCT=0

# ---------------------------------------------------------------------------
# 슬리피지(Slippage) / 스프레드(Spread) 설정 예시
# 값 단위로 다양한 형식 허용: 예) 5bp, 0.5%, 0.0005
# - 백테스트에서는 스프레드(호가) + 슬리피지(체결영향)를 모델링합니다.
# - 실전에서는 기본적으로 API의 bid/ask 및 체결결과를 우선 신뢰합니다.
#   인위적 슬리피지를 실전에도 적용하려면 APPLY_SLIPPAGE_IN_LIVE=1 로 설정하세요.
# ---------------------------------------------------------------------------
# 백테스트 기본값 (단위: 소수, 예: 0.0005 == 5bp)
ETF_BASE_SLIPPAGE=0.0005
ETF_SPREAD_PCT=0.0005

# 실전 관련 설정
# 0: 실전에서는 인위적 슬리피지 미적용(권장 기본) / 1: 실전에서도 지정 슬리피지 적용
APPLY_SLIPPAGE_IN_LIVE=0
# 실전에서 인위적 슬리피지를 적용하려면 지정 (예: 5bp -> 0.0005)
LIVE_SLIPPAGE_PCT=0.0005
# 실전에서 API로 bid/ask를 얻지 못할 때의 fallback 스프레드
LIVE_SPREAD_PCT=0.0005
# 실전 bid-ask 스프레드가 이 값을 초과하면 매수 주문을 스킵
MAX_LIVE_SPREAD_PCT=0.005
# 실전 위험 모니터링 경고 임계값 (0이면 해당 경고 비활성)
LIVE_CONCENTRATION_WARN_PCT=0.60
LIVE_DRAWDOWN_WARN_PCT=0.15

# KIS API 인증 정보 (BROKER_TYPE=KIS 일 때)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_ACCOUNT_PROD_CD=01
# KIS_CONFIG_PATH=  # 토큰 캐시 경로 (기본: .kis_token_cache/)
# KIS_API_TIMEOUT=15  # KIS API 호출 타임아웃 (초)
# KIS_AUTH_TIMEOUT=10  # KIS 토큰/웹소켓 인증 타임아웃 (초)
# KIS_TOKEN_MAX_RETRIES=3  # KIS 토큰 발급 재시도 횟수 (네트워크/rate-limit/5xx)

TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
