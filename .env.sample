# KRX(한국거래소) API 인증 정보
# pykrx 라이브러리를 통해 주식 데이터를 조회할 때 필요합니다.
# 실제 환경에서 사용할 때는 .env 파일을 생성하고 다음 값들을 설정하세요.
KRX_ID=your_krx_id
KRX_PW=your_krx_password

# 종목명 조회 활성화 여부
# KRX 인증 정보가 있을 때만 의미가 있습니다.
# 0: 비활성화 (기본값, 종목 티커만 사용)
# 1: 활성화 (실제 종목명을 조회하여 저장)
ENABLE_TICKER_NAME_LOOKUP=0

# Cash / deposit (kt00001 예수금상세현황요청)
# qry_tp: 2=일반조회, 3=추정조회
KIWOOM_CASH_QRY_TP=2

# Holdings / balance (kt00018 계좌평가잔고내역요청)
# qry_tp: 1=합산, 2=개별 / dmst_stex_tp: KRX=한국거래소, NXT=넥스트트레이드
KIWOOM_HOLDINGS_DMST_STEX_TP=KRX
